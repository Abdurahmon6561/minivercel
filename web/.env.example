# Supabase project URL and the ANON key. The anon key is public by design and is
# the only Supabase key that may ever appear in the browser.
# The service_role key must NEVER be used here (SPEC.md non-negotiable #4).
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# The Phase 1 API.
VITE_API_BASE_URL=https://minivercel.onrender.com

# GitHub OAuth scope requested at sign-in. `public_repo` is least privilege and
# enough for Phase 3 on public repositories; use `repo` only if you need private
# ones, and understand that it is read/write on every repo the user can see.
VITE_GITHUB_SCOPES=public_repo
