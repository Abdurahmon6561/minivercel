# ---------------------------------------------------------------------------
# MiniVercel - server configuration
#
# NON-NEGOTIABLE #4: SUPABASE_SERVICE_KEY is the service_role key. It lives ONLY
# here / in Render's secret store. It must never reach the frontend, never
# appear in a response body, and never be logged.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# service_role key (Project Settings -> API -> service_role). SERVER ONLY.
SUPABASE_SERVICE_KEY=

# Public storage bucket that holds deployed sites. Must exist and be PUBLIC READ.
SUPABASE_BUCKET=sites

# --- JWT verification -------------------------------------------------------
# Supply ONE of these:
#   Legacy projects (HS256): the JWT secret from Project Settings -> API.
SUPABASE_JWT_SECRET=
#   New projects (ES256/RS256 signing keys): leave the secret blank and the
#   server verifies against {SUPABASE_URL}/auth/v1/.well-known/jwks.json.

# Expected `aud` claim on user tokens. Supabase uses "authenticated".
SUPABASE_JWT_AUDIENCE=authenticated

# --- Public origin ----------------------------------------------------------
# Absolute site URLs in API responses AND, from Phase 3 on, the URL registered
# as the GitHub webhook and baked into the committed Actions workflow. Changing
# it means re-importing projects and re-enabling builds.
PUBLIC_BASE_URL=http://localhost:8000

# --- Limits (defaults match SPEC.md; override only if you know why) ---------
MAX_DEPLOYMENT_BYTES=52428800
MAX_FILES_PER_DEPLOYMENT=500
MAX_USER_BYTES=104857600
# Largest HTML page we will proxy. HTML is proxied rather than redirected
# because Supabase serves text/html as text/plain on public URLs; see
# SPEC.md non-negotiable #2. Everything else is redirected and uncapped.
MAX_PROXY_BYTES=5242880
SERVE_RATE_LIMIT_PER_MIN=60
UPLOAD_RATE_LIMIT_PER_HOUR=20

# CORS origins for the Phase 2 dashboard, comma separated.
CORS_ORIGINS=http://localhost:5173

# --- Phase 2: GitHub provider tokens ---------------------------------------
# Fernet key encrypting the stored GitHub OAuth token and each project's webhook
# secret. Without it the server REFUSES to store a token rather than writing it
# in plaintext. Rotating it invalidates both: users reconnect, projects re-import.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_KEY=
