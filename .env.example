# ---------------------------------------------------------------------------
# MiniVercel - server configuration
#
# NON-NEGOTIABLE #4: SUPABASE_SERVICE_KEY is the service_role key. It lives ONLY
# here / in Render's secret store. It must never reach the frontend, never
# appear in a response body, and never be logged.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# service_role key (Project Settings -> API -> service_role). SERVER ONLY.
SUPABASE_SERVICE_KEY=

# Public storage bucket that holds deployed sites. Must exist and be PUBLIC READ.
SUPABASE_BUCKET=sites

# --- JWT verification -------------------------------------------------------
# Supply ONE of these:
#   Legacy projects (HS256): the JWT secret from Project Settings -> API.
SUPABASE_JWT_SECRET=
#   New projects (ES256/RS256 signing keys): leave the secret blank and the
#   server verifies against {SUPABASE_URL}/auth/v1/.well-known/jwks.json.

# Expected `aud` claim on user tokens. Supabase uses "authenticated".
SUPABASE_JWT_AUDIENCE=authenticated

# --- Public origin ----------------------------------------------------------
# Absolute site URLs in API responses AND, from Phase 3 on, the URL registered
# as the GitHub webhook and baked into the committed Actions workflow. Changing
# it does NOT change an already-registered webhook or an already-committed
# workflow file - both were only ever written once, at the moment they were
# created - so after changing this, run:
#   python scripts/reimport_all.py
# to bring every existing GitHub-imported project's webhook and workflow
# forward to the new value. New imports and newly-enabled builds already pick
# up whatever this is set to; only pre-existing ones need the script.
#
# getdropbin.xyz: PUBLIC_BASE_URL=https://api.getdropbin.xyz
PUBLIC_BASE_URL=http://localhost:8000

# AUTODEPLOY.md section 1. "path" serves sites at {PUBLIC_BASE_URL}/s/{slug}/;
# "subdomain" serves them at https://{slug}.{SITE_DOMAIN}/ - Host-based
# routing (app/hostrouting.py) then also serves the API at
# https://api.{SITE_DOMAIN}, the dashboard at https://app.{SITE_DOMAIN}, and
# redirects the bare domain to the dashboard. Needs a wildcard DNS record
# (Cloudflare) plus its Universal SSL cert (covers one subdomain level only -
# app/naming.py rejects a slug with a dot for exactly this reason). Only the
# routing layer changes - the database, storage keys and deploy pipeline are
# identical either way.
#
# getdropbin.xyz: URL_MODE=subdomain, SITE_DOMAIN=getdropbin.xyz
URL_MODE=path
SITE_DOMAIN=

# Where the dashboard's build (`npm run build` in web/, producing web/dist)
# lives on disk. Only read when URL_MODE=subdomain, to answer
# https://app.{SITE_DOMAIN}. The Dockerfile's `webbuild` stage puts one at
# /app/web-dist and sets this to match; unset in path mode, where the
# dashboard is not served by this API at all.
DASHBOARD_DIST_DIR=web/dist

# --- Limits (defaults match SPEC.md; override only if you know why) ---------
MAX_DEPLOYMENT_BYTES=52428800
MAX_FILES_PER_DEPLOYMENT=500
MAX_USER_BYTES=104857600
# Largest HTML page we will proxy. HTML is proxied rather than redirected
# because Supabase serves text/html as text/plain on public URLs; see
# SPEC.md non-negotiable #2. Everything else is redirected and uncapped.
MAX_PROXY_BYTES=5242880
SERVE_RATE_LIMIT_PER_MIN=60
UPLOAD_RATE_LIMIT_PER_HOUR=20

# CORS origins for the Phase 2 dashboard, comma separated. Only matters for
# browser calls to api.{SITE_DOMAIN} in subdomain mode / this origin in path
# mode - a same-origin page load (the dashboard itself, a served site) never
# triggers CORS at all.
#
# getdropbin.xyz: CORS_ORIGINS=https://app.getdropbin.xyz,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Phase 5: administrative endpoints -------------------------------------
# Shared secret guarding POST /api/admin/gc, which sweeps every project for
# collectable deployments. Compared with hmac.compare_digest, never ==.
#
# LEAVE IT BLANK AND THE ENDPOINT IS DISABLED (503), which is the safe default:
# an unset secret must never be read as "no check required". Garbage collection
# still runs opportunistically after every successful deploy without it - this
# only adds the manual full sweep.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Phase 2: GitHub provider tokens ---------------------------------------
# Fernet key encrypting the stored GitHub OAuth token and each project's webhook
# secret. Without it the server REFUSES to store a token rather than writing it
# in plaintext. Rotating it invalidates both: users reconnect, projects re-import.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_KEY=
